<?php

/** @var \Swissup\Ignition\Block\Js $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$flareApp = $block->getFlareJs();

$scriptString = <<<JS

{$flareApp}

flare.light('{$escaper->escapeJs($block->getProjectKey())}');

// Cookies may contain CSRF and session tokens
flare.configure({
    beforeSubmit: (report) => {
        const cookies = report.attributes?.['http.request.cookies'];
        Object.keys(cookies || {}).forEach((name) => { cookies[name] = '<CENSORED>'; });
        return report;
    }
});

JS;

if (isset($secureRenderer)) {
    /* @noEscape */ echo $secureRenderer->renderTag('script', [], $scriptString, false);
} else {
    /* @noEscape */ echo "<script>{$scriptString}</script>";
}

?>
