{
    "name": "swissup/module-ignition",
    "description": "A beautiful error page and error tracking service for Magento",
    "type": "magento2-module",
    "version": "1.3.4",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "spatie/ignition": "^1.13"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Swissup\\Ignition\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
